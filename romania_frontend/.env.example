# Copy this file to .env.local for local development, and set the same
# variables in the Vercel project settings for production.

# URL of the deployed FastAPI backend (no trailing slash needed).
# Local dev default is http://127.0.0.1:8000 if this is unset.
# In production, set this to your Render service URL, e.g.:
#   https://romania-pathfinding-api.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase project configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the frontend itself. Used for auth redirects.
# Local: http://localhost:3000
# Production: your Vercel domain, e.g. https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
